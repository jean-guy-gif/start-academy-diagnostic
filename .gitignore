# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log

# backups (dumps SQL + Storage) — jamais commiter
/backups/

# supabase CLI — état runtime local (project-ref, versions cachées,
# pooler-url…). Rien de secret mais rien à versionner.
/supabase/.temp/

# env files (can opt-in for committing if needed)
.env*
# Exception : .env.example est un template documentaire sans secret,
# à versionner explicitement (cf. fix NEXT_PUBLIC_APP_URL).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.restore-test

# backups (dumps SQL + Storage exports — PII, jamais dans le repo)
backups/
