# Copy this file to `.env.local` and renseigner les valeurs réelles.
# Ne JAMAIS commiter de .env.local — il contient des secrets serveur.

# -----------------------------------------------------------------------------
# Environnement applicatif
# -----------------------------------------------------------------------------
# Cycle de vie de l'app. Valeurs reconnues :
#   - local      : développement local, fallbacks tolérés
#                  (créateur de client admin renvoie `null` si la clé
#                  service_role est absente, etc.)
#   - preprod    : pré-production — failfast activé sur les variables
#                  Supabase critiques (SUPABASE_SERVICE_ROLE_KEY).
#   - production : production — failfast actif idem.
#
# Si la variable n'est pas définie, on retombe sur NODE_ENV
# (`production` ⇒ failfast, sinon mode local).
APP_ENV=local

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# URL publique du projet Supabase (côté navigateur OK).
NEXT_PUBLIC_SUPABASE_URL=
# Clé anon publique (côté navigateur OK, RLS protège).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service role — STRICTEMENT serveur. Jamais préfixée NEXT_PUBLIC_.
# OBLIGATOIRE en APP_ENV=preprod ou production : `createSupabaseAdminClient`
# lève une erreur explicite si la clé est manquante hors environnement local.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# URL publique absolue de l'application
# -----------------------------------------------------------------------------
# Sert de base pour construire tous les liens envoyés à un utilisateur
# externe via `public_access_tokens` (lien dirigeant, lien participant,
# lien formateur). Consommée UNIQUEMENT par
# `POST /api/sessions/[id]/create-access-link` via
# `src/lib/config/app-url.ts::absoluteAppUrl()`.
#
# ⚠️ OBLIGATOIRE en production (NODE_ENV=production).
# `absoluteAppUrl()` THROW explicitement si absente, pour éviter
# qu'un lien `localhost` ou l'URL Vercel de déploiement instable
# (`https://…-hashXXX-jean-guy-s-projects.vercel.app`) parte dans un
# email à un dirigeant externe. En dev, fallback silencieux vers
# `http://localhost:3000`.
#
# Valeurs typiques :
#   - dev local     : http://localhost:3000
#   - preprod / prod : https://start-academy-diagnostic.vercel.app
#                     (ou domaine custom une fois branché)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OpenRouter (passerelle LLM unique pour la recommandation IA)
# -----------------------------------------------------------------------------
# Clé API OpenRouter. Si vide, l'API bascule sur le moteur heuristique local.
OPENROUTER_API_KEY=
# Modèle par défaut. Voir https://openrouter.ai/models.
# Note : `anthropic/claude-3.5-sonnet` a été retiré du catalogue
# OpenRouter (404). Successeur direct : `anthropic/claude-sonnet-4.5`.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Budget de sortie. Défaut code 8192. Code clampé dans [1024, 20000].
# Recommandé 20000 pour `/generate-training-support` et
# `/design-training-support` (sortie longue, ~52 slides).
OPENROUTER_MAX_TOKENS=20000
# URL du site (envoyée en HTTP-Referer pour les analytics OpenRouter).
OPENROUTER_SITE_URL=http://localhost:3000
# Nom de l'app (envoyé en X-Title pour les analytics OpenRouter).
OPENROUTER_APP_NAME=Start Academy Diagnostic

# -----------------------------------------------------------------------------
# Budget IA mensuel — alerte cockpit (cf. docs/ai-budget-prd.md)
# -----------------------------------------------------------------------------
# Enveloppe mensuelle estimée en EUR. Si vide ou non numérique, le
# cockpit affiche « Non configuré » et aucune alerte n'est levée.
# Pas de blocage automatique sur ce sprint — purement observable.
AI_MONTHLY_BUDGET_EUR=50
# Seuil d'alerte en % (warning si dépensé >= threshold). 80 par défaut.
# Valeur acceptée dans ]0, 100].
AI_MONTHLY_WARNING_THRESHOLD_PERCENT=80

# -----------------------------------------------------------------------------
# Gmail Draft (création de brouillons uniquement — JAMAIS d'envoi automatique)
# -----------------------------------------------------------------------------
# Si l'une de ces variables est vide, la route /api/email/create-draft
# renvoie `not_configured` et l'UI propose toujours `mailto:` ou copie
# manuelle. Documentation : docs/gmail-draft-integration.md.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
